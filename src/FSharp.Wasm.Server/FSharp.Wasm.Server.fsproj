<Project Sdk="Microsoft.NET.Sdk">
  <!-- The portable layer of the backend modules: HTTP types and the GGBP wire format (with the UTF-8 and hex it needs).  What a module gets from its host
       (host/runtime/server.js of fsharp-wasm-edge) is FSharp.Wasm.Server.Host, a project of its own: a client that speaks the protocol builds on this one and
       has no host.  Written in the subset fsharp-wasm compiles — no System.IO, no exceptions, no System.Text — so the same sources run under .NET (the tests)
       and as WebAssembly GC on Cloudflare, Vercel, Netlify, Deno, Bun, Node and in a browser.  The libraries beside it (FSharp.Wasm.Protocol, Ghost, Host, …)
       are the .NET reference this layer is checked against. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>FSharp.Wasm.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <!-- the collections of FSharp.Wasm.Core, only for the WebAssembly build (the front end sets FABLE_COMPILER_WASMGC) -->
  <Import Project="$(FSharpWasmCoreDir)/FSharp.Wasm.Core.props" Condition="'$(FABLE_COMPILER_WASMGC)' == 'True'" />
  <ItemGroup>
    <Compile Include="Bytes.fs" />
    <Compile Include="Ggbp.fs" />
    <Compile Include="Http.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- JSON and number parsing are not the backend's: they are FSharp.Wasm.Data, shared with the other repositories -->
    <ProjectReference Include="$(FSharpWasmCoreRoot)/FSharp.Wasm.Data/FSharp.Wasm.Data.fsproj" />
  </ItemGroup>
</Project>
