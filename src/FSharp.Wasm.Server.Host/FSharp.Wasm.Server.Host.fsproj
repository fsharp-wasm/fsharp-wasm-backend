<Project Sdk="Microsoft.NET.Sdk">
  <!-- What a module that RUNS ON a host (fsharp-wasm-edge, host/runtime/server.js) needs of it: the imports it gets from the host, the key-value store, and the loop that reads the
       request and hands over the response.  Apart from FSharp.Wasm.Server on purpose: a program that only speaks the protocol (the canvas client of the Ghost Todo) builds on
       that and must not carry these imports, which a browser does not have.  Same namespace; written in the subset fsharp-wasm compiles. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>FSharp.Wasm.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <!-- the collections of FSharp.Wasm.Core, only for the WebAssembly build (the front end sets FABLE_COMPILER_WASMGC) -->
  <Import Project="$(FSharpWasmCoreDir)/FSharp.Wasm.Core.props" Condition="'$(FABLE_COMPILER_WASMGC)' == 'True'" />
  <ItemGroup>
    <!-- [<Import>] and nativeOnly: the stub of FSharp.Wasm.Core -->
    <Compile Include="$(FSharpWasmCoreDir)/Interop.fs" />
    <Compile Include="Host.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSharp.Wasm.Server/FSharp.Wasm.Server.fsproj" />
  </ItemGroup>
</Project>
