<Project Sdk="Microsoft.NET.Sdk">
  <!-- The model of the Ghost Todo and what a client keeps of it, shared by the server module (demos/ghost-todo) and the canvas client
       (demos/ghost-todo-canvas).  Portable F# in the subset fsharp-wasm compiles: the same sources run under .NET (the tests) and as WebAssembly GC. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GhostTodoCore</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Todos.fs" />
    <Compile Include="Shadow.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FSharp.Wasm.Server/FSharp.Wasm.Server.fsproj" />
  </ItemGroup>
</Project>
